# Hygraph Content API — high-performance read-only CDN endpoint.
# Project settings -> API Access -> Content API, then copy the URL for the
# environment you want to read from (usually `master`).
#
# Public because it is queried from the browser as well as the server; the
# endpoint is read-only and only ever returns published content.
NEXT_PUBLIC_HYGRAPH_ENDPOINT=https://eu-west-2.cdn.hygraph.com/content/your-project-id/master
